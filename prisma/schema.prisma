generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  color         String         @default("#2563eb")
  entries       Entry[]
  activeTimers  ActiveTimer[]
  plannedBlocks PlannedBlock[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Entry {
  id              String    @id @default(cuid())
  title           String
  notes           String?
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int       @default(0)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startTime])
  @@index([categoryId])
}

model ActiveTimer {
  id         Int       @id @default(1)
  title      String
  notes      String?
  startedAt  DateTime  @default(now())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([categoryId])
}

model PlannedBlock {
  id         String    @id @default(cuid())
  title      String
  notes      String?
  startTime  DateTime
  endTime    DateTime
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([startTime])
  @@index([categoryId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dueDate])
  @@index([isCompleted])
}

model Goal {
  id            String     @id @default(cuid())
  title         String
  description   String?
  targetMinutes Int
  period        GoalPeriod @default(WEEKLY)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Routine {
  id          String   @id @default(cuid())
  title       String
  description String?
  timeOfDay   String
  days        Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Auth.js models. These store Google OAuth users, linked provider accounts, and login sessions.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
