# Desktop mode is the default. With DATABASE_URL unset, TodAI stores data in
# the platform application-data directory (for example %LOCALAPPDATA%\TodAI).
# TODAI_DATA_DIR=C:\Users\you\AppData\Local\TodAI

# Server mode: uncomment and provide an explicit PostgreSQL URL.
# DATABASE_URL=postgresql+asyncpg://todai:todai_dev@localhost:5432/todai

# Optional semantic search. Keyword search works without an API key.
EMBEDDING_PROVIDER=none
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
COMPLETION_PROVIDER=openai
COMPLETION_MODEL=gpt-5-mini
APP_ENV=development
DEBUG=true
